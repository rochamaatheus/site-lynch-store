# ---------------------------------------------------------------------------
# Lynch Store - modelo de configuracao de ambiente
#
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# O ".env" real NUNCA vai para o git (esta no .gitignore).
# Os valores abaixo sao os de um ambiente local com XAMPP.
# ---------------------------------------------------------------------------

# --- Banco de dados (MySQL / MariaDB) --------------------------------------
# No XAMPP: usuario root sem senha. Em cPanel, use o usuario/banco com prefixo
# criado no painel (ex.: DB_NAME=lynch_loja, DB_USER=lynch_admin).
DB_HOST=127.0.0.1
DB_NAME=lynchstore
DB_USER=root
DB_PASS=

# --- Aplicacao --------------------------------------------------------------
# APP_ENV=local     -> erros aparecem na tela (desenvolvimento)
# APP_ENV=production-> erros so no log do servidor (publicacao)
APP_ENV=local

# URL base do site, SEM barra no final. Usada para montar os links absolutos
# que entram na mensagem do WhatsApp.
# Local com "php -S": http://localhost:8000
# Local com Apache/XAMPP: http://localhost/ray
# Producao: https://www.lynchstore.com.br
APP_BASE_URL=http://localhost:8000

# Fuso horario usado nas datas do painel (opcional).
APP_TIMEZONE=America/Sao_Paulo

# --- Admin inicial ----------------------------------------------------------
# Usados APENAS por db/seed.php (fase 2) para criar o primeiro usuario do
# painel. A senha e gravada com password_hash() - o texto puro fica so aqui.
# Troque a senha pelo painel depois do primeiro login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
